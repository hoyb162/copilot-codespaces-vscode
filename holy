


# Ask for the user's name
name = input("What's your name? ")

# Greet the user
print(f"Hello, {name}!")

# Ask for the user's age
age = int(input("How old are you? "))

# Check if the user is eligible to vote
if age >= 18:
    print(f"{name}, you're eligible to vote!")
else:
    print(f"{name}, you're not eligible to vote yet. You need to be at least 18 years old.")
